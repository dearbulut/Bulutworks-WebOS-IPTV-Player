{
  "name": "bulutworks-webos-iptv",
  "version": "0.1.0",
  "description": "Open-source IPTV player for LG webOS TVs. M3U + Xtream Codes. Mediabunny pipeline.",
  "license": "MIT",
  "author": "Mehmet Bulut <github.com/dearbulut>",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/copy-webos-meta.mjs",
    "package:ipk": "ares-package dist -o ./out --no-minify",
    "clean": "rimraf dist out"
  },
  "dependencies": {
    "@mediabunny/ac3": "^1.46.0",
    "@noriginmedia/norigin-spatial-navigation": "^2.3.0",
    "mediabunny": "^1.46.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.2"
  }
}
